# Luna environment overrides (optional)
# Copy to .env or export these variables.

# Startup model provider: openrouter | groq | ollama (the web UI can switch live)
# LUNA_PROVIDER=openrouter

# OpenRouter model and API key (get a key from https://openrouter.ai/keys)
LUNA_MODEL_NAME=nvidia/nemotron-3-ultra-550b-a55b
LUNA_OPENROUTER_API_KEY=your_openrouter_api_key_here

# Groq (https://console.groq.com/keys)
# LUNA_GROQ_API_KEY=gsk_...
# LUNA_GROQ_MODEL=llama-3.3-70b-versatile

# Ollama (local; run `ollama serve`, use a model that supports tools)
# LUNA_OLLAMA_BASE_URL=http://localhost:11434/v1
# LUNA_OLLAMA_MODEL=qwen3:8b

# memory | sqlite
LUNA_MEMORY_BACKEND=sqlite
# LUNA_CHECKPOINT_PATH=./data/luna_memory.sqlite

# MCP
LUNA_ENABLE_MCP_TOOLS=true
LUNA_ENABLE_BUILTIN_TOOLS=true
# LUNA_MCP_CONFIG_PATH=./config/mcp_servers.json

# Default conversation thread id
LUNA_DEFAULT_THREAD_ID=default

# Summarize old messages once a thread passes this many tokens (0 = never)
# LUNA_SUMMARY_TRIGGER_TOKENS=12000
# LUNA_SUMMARY_KEEP_MESSAGES=20

# Loop limits per user message (stop runaway tool loops)
# LUNA_MAX_MODEL_CALLS=25
# LUNA_MAX_TOOL_CALLS=40
# Total model calls per user message across the main agent and all subagents
# LUNA_TASK_BUDGET=80

# Tavily web search key — enables the researcher subagent (https://app.tavily.com)
# LUNA_TAVILY_API_KEY=tvly-...

# Voice output for the web UI: piper (local neural voice; the core follows the
# real audio) or browser. The Piper voice (~60 MB) downloads once to data/voices.
# LUNA_TTS_ENGINE=piper
# LUNA_TTS_VOICE=en_US-lessac-medium
# LUNA_TTS_LENGTH_SCALE=0.95

# Web UI (uv run luna-web). Keep the host local: the agent can run commands.
# LUNA_WEB_HOST=127.0.0.1
# LUNA_WEB_PORT=8765
# Extra browser origins allowed to open the WebSocket (default: Vite dev server)
# LUNA_WEB_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
