# Luna environment overrides (optional)
# Copy to .env or export these variables.

# Ollama model tag
LUNA_MODEL_NAME=phi4-mini:latest

# memory | sqlite
LUNA_MEMORY_BACKEND=sqlite
# LUNA_CHECKPOINT_PATH=./data/luna_memory.sqlite

# MCP
LUNA_ENABLE_MCP_TOOLS=true
LUNA_ENABLE_BUILTIN_TOOLS=true
# LUNA_MCP_CONFIG_PATH=./config/mcp_servers.json

# Default conversation thread id
LUNA_DEFAULT_THREAD_ID=default
