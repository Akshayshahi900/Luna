# Luna environment overrides (optional)
# Copy to .env or export these variables.

# Startup model provider: openrouter | groq | ollama (the web UI can switch live)
# LUNA_PROVIDER=openrouter

# OpenRouter model and API key (get a key from https://openrouter.ai/keys)
LUNA_MODEL_NAME=nvidia/nemotron-3-ultra-550b-a55b
LUNA_OPENROUTER_API_KEY=your_openrouter_api_key_here

# Groq (https://console.groq.com/keys)
# LUNA_GROQ_API_KEY=gsk_...
# LUNA_GROQ_MODEL=llama-3.3-70b-versatile

# Ollama (local; run `ollama serve`, use a model that supports tools)
# LUNA_OLLAMA_BASE_URL=http://localhost:11434/v1
# LUNA_OLLAMA_MODEL=qwen3:8b

# Persona: how Luna talks and who she talks to (luna/agent/persona.py)
# concise = one or two spoken sentences | detailed = fuller written answers
LUNA_RESPONSE_STYLE=concise
# How Luna addresses you (empty = not used)
LUNA_USER_TITLE=Sir
# LUNA_USER_NAME=Alex
# Default place for weather / local questions
# LUNA_USER_LOCATION=London, UK
LUNA_UNITS=metric
# LUNA_TIMEZONE=Europe/London
# Free-form extra instructions (copy config/persona.example.md)
# LUNA_PERSONA_PATH=./config/persona.md

# memory | sqlite
LUNA_MEMORY_BACKEND=sqlite
# LUNA_CHECKPOINT_PATH=./data/luna_memory.sqlite

# Long-term memory across threads (docs/memory.md). Luna only suggests;
# you accept in the web Memory panel or with /memory in the CLI.
LUNA_ENABLE_LONGTERM_MEMORY=true
# LUNA_LONGTERM_MEMORY_PATH=./data/luna_longterm.sqlite
# LUNA_MEMORY_RECALL_LIMIT=5
# LUNA_MEMORY_PROMPT_CHARS=1500
# LUNA_MEMORY_MAX_SUGGESTIONS=3

# MCP
LUNA_ENABLE_MCP_TOOLS=true
LUNA_ENABLE_BUILTIN_TOOLS=true
# LUNA_MCP_CONFIG_PATH=./config/mcp_servers.json

# Every start (CLI) and every tab or reload (web) opens a NEW session.
# Resume old ones with `luna --resume`, /sessions + /resume, or the web SESSIONS list.

# Summarize old messages once a thread passes this many tokens (0 = never)
LUNA_SUMMARY_TRIGGER_TOKENS=12000
# Recent history kept word-for-word after a summary (capped at half the trigger)
LUNA_SUMMARY_KEEP_TOKENS=4000

# Loop limits per user message (stop runaway tool loops)
# Kept low on purpose: every model call is one API request (free tiers run out fast)
LUNA_MAX_MODEL_CALLS=10
LUNA_MAX_TOOL_CALLS=20
# Total model calls per user message across the main agent and all subagents
LUNA_TASK_BUDGET=30
# Retries for a failed / rate-limited model request (each retry is another request)
LUNA_MODEL_MAX_RETRIES=1

# Tavily web search key — enables the researcher subagent (https://app.tavily.com)
LUNA_TAVILY_API_KEY=tvly-...

# To-do file for the assistant helper (servers/tasks_mcp_server.py); syncs with
# Google Tasks once you are signed in (see Google below)
LUNA_TASKS_PATH=./data/tasks.json

# Mail for the assistant helper (servers/mail_mcp_server.py, docs/mail.md).
# Reading runs freely; sending and replying always ask you first.
# gmail = Gmail API with the Google sign-in below (nothing else to set);
# imap  = any provider with an APP password (the LUNA_MAIL_* lines).
# LUNA_MAIL_BACKEND=gmail
# LUNA_MAIL_ADDRESS=you@gmail.com
# LUNA_MAIL_PASSWORD=abcd efgh ijkl mnop
# LUNA_MAIL_USERNAME=              # only if the login differs from the address
# LUNA_MAIL_IMAP_HOST=imap.gmail.com
# LUNA_MAIL_IMAP_PORT=993
# LUNA_MAIL_SMTP_HOST=smtp.gmail.com
# LUNA_MAIL_SMTP_PORT=465          # 465 = SSL, 587 = STARTTLS
# LUNA_MAIL_MAX_BODY_CHARS=4000

# Google: Gmail, Calendar, and to-dos synced with Google Tasks (docs/google.md).
# Put the OAuth "Desktop app" client JSON at the path below, then sign in
# once: uv run luna-google-auth
# LUNA_GOOGLE_CREDENTIALS_PATH=./data/google/credentials.json
# LUNA_GOOGLE_TOKEN_PATH=./data/google/token.json
# LUNA_GOOGLE_CALENDAR_ID=primary
# LUNA_GOOGLE_TASKLIST_ID=@default   # the Google task list data/tasks.json syncs with
# LUNA_TASKS_GOOGLE_SYNC=true

# Voice input for the web UI: whisper (local, any browser, "Hey Luna" wake word)
# or browser (Chrome/Edge recognition). The model downloads once to data/models.
LUNA_STT_ENGINE=whisper
LUNA_STT_MODEL=base.en        # tiny.en (fastest) | base.en | small.en (most accurate)
LUNA_STT_THREADS=4

# Voice output for the web UI: piper (local neural voice; the core follows the
# real audio) or browser. The Piper voice (~60 MB) downloads once to data/voices.
LUNA_TTS_ENGINE=piper
LUNA_TTS_VOICE=en_US-lessac-medium
LUNA_TTS_LENGTH_SCALE=0.95

# Web UI (uv run luna-web). Keep the host local: the agent can run commands.
LUNA_WEB_HOST=127.0.0.1
LUNA_WEB_PORT=8765
# Extra browser origins allowed to open the WebSocket (default: Vite dev server)
LUNA_WEB_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# luna-web opens Luna in its own app window (Chrome / Chromium / Edge / Brave
# in app mode); closing it stops the server. `luna-web --no-window` skips it once.
# LUNA_WEB_OPEN_WINDOW=true
# LUNA_WEB_CLOSE_WITH_WINDOW=true
# LUNA_WEB_BROWSER=chromium

# Routines (web UI Control Center → Routines): scheduled mail / agenda / to-do
# checks (no LLM) and your own agent prompts. They run only while luna-web runs.
# LUNA_ROUTINES_ENABLED=true
# LUNA_ROUTINES_PATH=./data/luna_routines.sqlite
